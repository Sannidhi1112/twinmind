# as it contains information specific to your local configuration.
#
# Location of the android SDK. This is set automatically on Android Studio install.
# On macOS, this is typically /Users/<username>/Library/Android/sdk
# On Windows, this is typically C:\Users\<username>\AppData\Local\Android\sdk
# On Linux, this is typically /home/<username>/Android/Sdk
sdk.dir=/path/to/your/Android/sdk

